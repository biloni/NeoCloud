# Local dev default: SQLite file, zero setup required.
DATABASE_URL="file:./dev.db"

# Optional locally. Without it, the /ask NL query feature shows a clear
# "not configured" message instead of crashing. Required for deployment.
ANTHROPIC_API_KEY=""

# --- Production (once Supabase/Vercel accounts exist) ---
# Swap DATABASE_URL to the Supabase pooler connection string and set
# DIRECT_URL to the direct connection string (see prisma/POSTGRES_MIGRATION.md).
# DATABASE_URL="postgresql://...pooler..."
# DIRECT_URL="postgresql://...direct..."
